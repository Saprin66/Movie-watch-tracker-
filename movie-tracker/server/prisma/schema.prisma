generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(uuid())
  username  String      @unique
  password  String
  movies    UserMovie[]
  createdAt DateTime    @default(now())
}

model UserMovie {
  id        String      @id @default(uuid())
  tmdbId    Int
  title     String
  posterUrl String?
  status    MovieStatus @default(WATCHLIST)

  userId    String
  user      User        @relation(fields: [userId], references: [id])

  createdAt DateTime    @default(now())

  @@unique([userId, tmdbId])
}

enum MovieStatus {
  WATCHED
  WATCHLIST
}