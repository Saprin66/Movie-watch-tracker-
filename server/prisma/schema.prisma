generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(uuid())
  username         String      @unique
  email            String      @unique
  password         String
  isVerified       Boolean     @default(false)
  verificationCode String?
  codeExpiresAt    DateTime?
  codeAttempts     Int         @default(0)
  policyAcceptedAt  DateTime?   // когда принята политика конфиденциальности
  policyVersion     String?     // редакция политики, которую приняли
  resetCodeHash     String?     // HMAC кода сброса пароля (сам код не хранится)
  resetExpiresAt    DateTime?
  resetAttempts     Int         @default(0)
  resetRequestedAt  DateTime?
  passwordChangedAt DateTime?   // старые токены после смены пароля недействительны
  bio              String?
  // Приватный профиль: журнал, статистику и друзей видят только друзья
  isPrivate        Boolean     @default(false)
  // Тариф подписки: free | gold | brilliant (оплаты пока нет, выдаётся вручную)
  plan             String      @default("free")
  // Тема оформления профиля (только Brilliant): sunset | ocean | aurora | neon | rose
  profileTheme     String?
  // Временная подписка по промокоду: действует до promoUntil поверх основного plan
  promoPlan        String?
  promoUntil       DateTime?
  // Активированные промокоды: каждый можно ввести только один раз
  promoCodesUsed   String[]    @default([])
  // Витрина фильмов удалена из приложения. Колонку не убираем из схемы: prisma db push
  // при запуске сервера отказался бы удалять её с данными. Удалить вручную при миграции.
  showcaseMovieIds String[]    @default([])
  lastSeen     DateTime    @default(now()) 
  avatar           String?
  movies           UserMovie[]
  friends          Friend[]    @relation("userFriends")
  friendOf         Friend[]    @relation("friendOf")
  ownedLists       SharedList[]       @relation("ownedLists")
  listMemberships  SharedListMember[]
  listItemsAdded   SharedListItem[]   @relation("listItemsAdded")
  pushTokens       PushToken[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Friend {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  status    String   @default("pending") // pending, accepted, rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("userFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("friendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model UserMovie {
  id        String   @id @default(uuid())
  tmdbId    Int
  title     String
  posterUrl String?
  mediaType String   @default("movie") // movie | tv
  status    String   @default("WATCHLIST")
  rating    Int?       // 1-10
  comment   String?
  watchedAt DateTime?  // когда отмечен просмотренным
  releaseYear   Int?       // год выхода (для фильтров)
  genres        String[]  @default([]) // названия жанров (для фильтров)
  metaCheckedAt DateTime?  // когда год и жанры были заполнены
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes  EpisodeWatch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Просмотренные серии сериала из журнала
model EpisodeWatch {
  id          String    @id @default(uuid())
  userMovieId String
  userMovie   UserMovie @relation(fields: [userMovieId], references: [id], onDelete: Cascade)
  season      Int
  episode     Int
  runtime     Int?      // длительность серии в минутах на момент отметки (для статистики)
  watchedAt   DateTime  @default(now())

  @@unique([userMovieId, season, episode])
  @@index([userMovieId])
}

// Общий список «смотрим вместе»: владелец и друзья-участники добавляют фильмы
model SharedList {
  id        String             @id @default(uuid())
  name      String
  ownerId   String
  owner     User               @relation("ownedLists", fields: [ownerId], references: [id], onDelete: Cascade)
  members   SharedListMember[]
  items     SharedListItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([ownerId])
}

// Участник общего списка (владелец тоже записан участником).
// Приглашённый друг сначала в статусе pending и становится участником, только когда примет приглашение.
model SharedListMember {
  id        String     @id @default(uuid())
  listId    String
  userId    String
  list      SharedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String     @default("accepted") // pending — приглашён, ждёт ответа; accepted — участник
  createdAt DateTime   @default(now())

  @@unique([listId, userId])
  @@index([userId])
}

// Фильм или сериал в общем списке
model SharedListItem {
  id          String     @id @default(uuid())
  listId      String
  list        SharedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  tmdbId      Int
  mediaType   String     @default("movie") // movie | tv
  title       String
  posterUrl   String?
  releaseYear Int?
  watched     Boolean    @default(false)
  addedById   String?
  addedBy     User?      @relation("listItemsAdded", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@unique([listId, tmdbId, mediaType])
  @@index([listId])
}

// Токен устройства для push-уведомлений в мобильном приложении (Expo Push).
// Один пользователь может войти с нескольких телефонов.
model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  platform  String?  // ios | android
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
